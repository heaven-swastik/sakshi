# SAKSHI environment variables
# Copy this to .env and never commit .env

# Token secret — change this in production, keep it in a KMS
SAKSHI_TOKEN_SECRET=sakshi-dev-secret-change-in-prod

# SQLite database path
DATABASE_URL=sqlite:///./sakshi.db

# Environment: demo | production
SAKSHI_ENV=demo

# JWT secret
JWT_SECRET=sakshi-jwt-dev-secret-change-in-prod

# Credential key path (auto-generated if missing)
CREDENTIAL_KEY_PATH=./credential_key.pem

